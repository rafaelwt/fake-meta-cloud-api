# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database
DB_PATH=./data/fake-meta-api.db

# Meta WhatsApp Business Account Configuration
WABA_ID=123456789012345
PHONE_NUMBER_ID=987654321098765
DISPLAY_PHONE_NUMBER=+1234567890

# Webhook Configuration
WEBHOOK_URL=http://localhost:4000/webhook
WEBHOOK_VERIFY_TOKEN=your_verify_token_here

# Authentication
API_ACCESS_TOKEN=your_fake_bearer_token_here

# App secret used to sign webhooks (X-Hub-Signature-256 header)
APP_SECRET=your_fake_app_secret_here

# Message Status Delays (in milliseconds)
# These control how long to wait before sending each webhook status
DELAY_SENT_MIN=500
DELAY_SENT_MAX=2000
DELAY_DELIVERED_MIN=3000
DELAY_DELIVERED_MAX=5000
DELAY_READ_MIN=5000
DELAY_READ_MAX=10000

# Behavior Configuration
# Probability (0-1) that a message will be marked as "read"
READ_PROBABILITY=0.7

# Customer service window (24h)
# true: free-form messages fail with 131047 unless the recipient sent an
# inbound message (POST /:version/:wabaId/simulate/inbound) in the last 24h
SERVICE_WINDOW_ENFORCED=false

# Error Simulation Patterns
# Phone numbers matching these patterns will trigger specific errors
# Format: PATTERN:ERROR_CODE (comma separated)
# Example: +99999:131026,+88888:131047
ERROR_PATTERNS=+99999:131026,+88888:131047,+77777:131031

# Template Pricing Categories
# Pricing category reported in status webhooks for template messages
# Format: TEMPLATE_NAME:CATEGORY (comma separated, trailing * matches a prefix)
# Categories: marketing, utility, authentication
TEMPLATE_CATEGORIES=otp_*:authentication,order_update:utility
TEMPLATE_DEFAULT_CATEGORY=marketing

# API reference at /docs (defaults to on only when NODE_ENV=development)
# DOCS_ENABLED=true

# Logging
LOG_LEVEL=info
LOG_PRETTY=true
